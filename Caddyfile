{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	@api path /api/* /health
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		# Static frontend (adjust the image in the reverse_proxy if needed)
		respond "Frontend not configured" 503
	}

	tls {$ADMIN_EMAIL}
}
