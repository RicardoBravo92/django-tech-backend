# ---------------------------------------------------------------------------
# backend (tech-backend-django)
#
# Copy this file to `.env` and adjust the values for your environment.
# ---------------------------------------------------------------------------

# --- Core security ---------------------------------------------------------
# Must be >= 32 chars and must not be the default value.
SECRET_KEY=dev-secret-key-change-me-to-a-long-random-string-32b-min
JWT_ALGORITHM=HS256

DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:3000

# --- Tokens / business rules ----------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=15
TAX_RATE=0.18
RATE_LIMIT_ENABLED=true

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://tech:tech_password@localhost:5433/tech_django


# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=<onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000
