# Copy this file to .env in production and NEVER commit it.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Database ---
POSTGRES_USER=tech
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=tech_django

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=false
# Long random secret key (>= 32 chars; the backend refuses to start without it)
SECRET_KEY=<generate-a-strong-key>
ALLOWED_HOSTS=api.example.com
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=15
TAX_RATE=0.18
RATE_LIMIT_ENABLED=true

# Allowed CORS origins (comma-separated). E.g. https://example.com
CORS_ORIGINS=https://example.com

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=Tech <noreply@example.com>
FRONTEND_URL=https://example.com

# --- Reverse proxy (HTTPS) ---
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# --- Gunicorn ---
GUNICORN_WORKERS=4
